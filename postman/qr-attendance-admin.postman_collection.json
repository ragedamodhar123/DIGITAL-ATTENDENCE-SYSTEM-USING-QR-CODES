{
  "info": {
    "name": "QR Attendance - Admin API",
    "description": "Admin API for the attendance system.\n\n1. Import this collection and the 'QR Attendance - Local' environment.\n2. In the environment, paste the token printed by `flask --app wsgi create-admin` into admin_token.\n3. Select the environment (top right) and run the requests top to bottom the first time.\n\nRequests that create something save its id (course_id, section_id, user_id) for the requests after them.\nTemporary passwords appear once in the response. Copy them before closing the response.\n\nRunning the Create requests a second time returns 409 (already exists). That is the duplicate protection working; change the codes or usernames in the body to create new records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "section_id",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "course_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Check server",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "No token needed. database must be ok.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
