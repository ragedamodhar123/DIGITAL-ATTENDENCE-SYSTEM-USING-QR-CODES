# Production settings. Copy to .env on the production machine and fill in every value.
# See DEPLOYMENT.md, section 3. Keep the real .env private (database password, secret key).

FLASK_CONFIG=production

# New random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Production database (URL-encode special characters in the password, e.g. @ -> %40)
DATABASE_URL=postgresql+psycopg://attendance_app:CHANGE_ME@localhost:5432/attendance

# The app sits behind cloudflared or Caddy on this machine
TRUSTED_PROXY_COUNT=1
TRUSTED_HOSTS=attendance.yourcollege.edu

# Where waitress listens (only the tunnel/proxy on this machine connects)
HOST=127.0.0.1
PORT=8000
WAITRESS_THREADS=8

# Logs and backups (defaults: logs\ and backups\ in the project folder)
LOG_DIR=
BACKUP_DIR=
BACKUP_KEEP=14
# PostgreSQL's bin folder, if flask check cannot find pg_dump
PG_BIN=

# Optional: accept attendance scans only from the college's public IP range(s)
ATTENDANCE_ALLOWED_NETWORKS=
