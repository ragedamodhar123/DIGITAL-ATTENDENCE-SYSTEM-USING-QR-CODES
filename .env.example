# Copy this file to .env and fill in real values. Never commit .env.

# development | testing | production
FLASK_CONFIG=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-characters

# If your password contains @ : / # % or spaces, URL-encode it (@ becomes %40).
DATABASE_URL=postgresql+psycopg://attendance_app:YOUR_PASSWORD@localhost:5432/attendance_dev

# Must point to a SEPARATE database whose name ends in _test. Tests delete all data in it.
TEST_DATABASE_URL=postgresql+psycopg://attendance_app:YOUR_PASSWORD@localhost:5432/attendance_test

# Number of reverse proxies in front of the app (ngrok / cloudflared / nginx = 1). Use 0 when running directly.
TRUSTED_PROXY_COUNT=0
