# Copy this file to .env and fill in real values. Never commit .env.

# development | testing | production
FLASK_CONFIG=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-characters

# If your password contains @ : / # % or spaces, URL-encode it (@ becomes %40).
DATABASE_URL=postgresql+psycopg://attendance_app:YOUR_PASSWORD@localhost:5432/attendance_dev

# Must point to a SEPARATE database whose name ends in _test. Tests delete all data in it.
TEST_DATABASE_URL=postgresql+psycopg://attendance_app:YOUR_PASSWORD@localhost:5432/attendance_test

# Number of reverse proxies in front of the app. Use 1 with Cloudflare Tunnel (cloudflared),
# 0 when phones/browsers connect to Flask directly. With 1, keep Flask listening on
# 127.0.0.1 only (the default of `flask run`), so nobody can bypass the tunnel.
TRUSTED_PROXY_COUNT=0

# Optional: accept attendance scans only from these networks (the college Wi-Fi's public
# IP addresses or ranges), comma-separated, e.g. 203.0.113.0/24,198.51.100.7. Empty = any.
ATTENDANCE_ALLOWED_NETWORKS=

# Production: the site's host name(s), comma-separated, e.g. attendance.college.edu.
# Requests for any other host name are refused. Empty = any (development, tunnel).
TRUSTED_HOSTS=

# ---- Production (Module 7) ---------------------------------------------------------
# FLASK_CONFIG=production
# Where serve.py listens. Keep 127.0.0.1 when a tunnel or reverse proxy runs on this computer.
HOST=127.0.0.1
PORT=8000
WAITRESS_THREADS=8
# Log files (production default: logs/ in the project). Empty outside production = terminal only.
LOG_DIR=
# Backups (default: backups/ in the project) and how many to keep.
BACKUP_DIR=
BACKUP_KEEP=14
# PostgreSQL's bin folder, if pg_dump is not found automatically, e.g.
# PG_BIN=C:\Program Files\PostgreSQL\17\bin
PG_BIN=C:\Program Files\PostgreSQL\17\bin
